DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional PostgreSQL configuration. Leave DB_ENGINE unset to use SQLite.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=skillora
DB_USER=skillora
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

# Email is sent to the console by default during development.
# Configure SMTP only when an authorized mail account is available.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=replace-with-your-mailbox
EMAIL_HOST_PASSWORD=replace-with-your-mail-password
DEFAULT_FROM_EMAIL=Skillora <no-reply@example.edu>

# Conversational AI (keep this server-side; never add the key to frontend code).
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=25
